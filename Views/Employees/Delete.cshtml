@model EmployeeCrudMvc.Models.Employee
@{ ViewData["Title"] = "Delete employee"; }
<h1>Delete employee</h1>
<div class="alert alert-warning">Are you sure you want to delete <strong>@Model.FirstName @Model.LastName</strong>?</div>
<dl class="row"><dt class="col-sm-2">Email</dt><dd class="col-sm-10">@Model.Email</dd><dt class="col-sm-2">Department</dt><dd class="col-sm-10">@Model.Department</dd></dl>
<form asp-action="Delete"><input type="hidden" asp-for="Id" /><button type="submit" class="btn btn-danger">Delete</button> <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></form>
