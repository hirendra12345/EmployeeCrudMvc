@model IEnumerable<EmployeeCrudMvc.Models.Employee>
@{ ViewData["Title"] = "Employees"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Employees</h1>
    <a class="btn btn-primary" asp-action="Create">Add employee</a>
</div>
@if (TempData["Success"] is string message)
{
    <div class="alert alert-success">@message</div>
}
<table class="table table-striped table-hover align-middle">
    <thead><tr><th>Name</th><th>Email</th><th>Department</th><th>Salary</th><th>Joining date</th><th></th></tr></thead>
    <tbody>
    @foreach (var employee in Model)
    {
        <tr>
            <td>@employee.FirstName @employee.LastName</td><td>@employee.Email</td><td>@employee.Department</td>
            <td>@employee.Salary.ToString("N2")</td><td>@employee.JoiningDate.ToString("dd MMM yyyy")</td>
            <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@employee.Id">View</a> <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@employee.Id">Edit</a> <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@employee.Id">Delete</a></td>
        </tr>
    }
    </tbody>
</table>
@if (!Model.Any()) { <p class="text-muted">No employees yet. Add the first employee.</p> }
